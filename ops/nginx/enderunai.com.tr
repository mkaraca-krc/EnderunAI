server {
    server_name enderunai.com.tr www.enderunai.com.tr;

    # Yetki paketiyle JWT'ye gömülü izin sayısı arttı (109 anahtara kadar),
    # bu da Set-Cookie başlığını büyütüyor — nginx'in varsayılan proxy
    # buffer boyutları bunu karşılamıyor ("upstream sent too big header").
    proxy_buffer_size 32k;
    proxy_buffers 4 32k;
    proxy_busy_buffers_size 64k;
    large_client_header_buffers 4 32k;

    # ─────────────────────────────────────────────────────────────
    # CC RAPOR DOSYASI — TEK DOSYA, SALT OKUNUR (KUTU/1 Parça 2).
    #
    # NEDEN DİZİN DEĞİL TEK DOSYA: `location ^~ /rapor-.../` yazsaydım
    # o dizine ileride düşen HER dosya yayınlanırdı. `location =` tam
    # eşleşmedir: yalnız `son.txt` sunulur, kardeşi bile sunulmaz.
    # Dizin listelemesi sorusu böylece hiç doğmuyor.
    #
    # YOL BİR YETKİ BELGESİDİR: 32 karakterlik rastgele parça,
    # tahmin edilemez olduğu için erişimi o sınırlıyor. Bu yüzden
    # dosyaya SIR YAZILMAZ — parola, belirteç, bağlantı dizesi,
    # kişisel veri geçmez; içerik teknik özettir.
    #
    # Erişim günlüğü AYRI dosyada: yolu kimin okuduğu, yayın
    # günlüğünün gürültüsüne karışmasın.
    location = /rapor-e99f29e0c5f0175281af016a10d75b64/son.txt {
        alias /var/www/enderun-rapor/son.txt;
        default_type text/plain;
        charset utf-8;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Cache-Control "no-store" always;
        access_log /var/log/nginx/enderun-rapor-erisim.log;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    # ── GİRİŞ UCU — HIZ SINIRI (2026-09-15) ─────────────────────
    #
    # TAM EŞLEŞME (`location =`) BİLEREK: `^~ /api/backend/auth/`
    # yazsaydım `work-hours-status` da sınırlanırdı — o uç her açık
    # sekmeden DAKİKADA BİR çağrılıyor ve sınırlanması oturumları
    # kırardı. Sınır YALNIZ giriş POST'una.
    location = /api/backend/auth/login {
        limit_req zone=giris_post burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/auth/login {
        limit_req zone=giris_post burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Giriş SAYFASI — saldırının vurduğu yüzey. Sınır daha cömert:
    # normal kullanıcı sayfayı birkaç kez yükler, saniyede birden
    # fazla SÜREKLİ yüklemez.
    location = /login {
        limit_req zone=giris_sayfa burst=30 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

location ^~ /api/auth/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

    location ^~ /api/backend/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # ── SIGNALR HUB — WEBSOCKET İÇİN AYRI VE DAR YOL ─────────────
    #
    # NEDEN AYRI: ön yüz her şeyi /api/backend/[...path] Next vekilinden
    # geçiriyor ama o bir `route.ts` — yalnız GET/POST/PUT/PATCH/DELETE
    # dışa aktarıyor ve WebSocket YÜKSELTMESİNİ GEÇİRMEZ.
    #
    # NEDEN /api'ye eklemek yerine ayrı location: `location /api`
    # tüm arka uç yüzeyi demek; oraya Upgrade eklemek yükseltmeyi 122
    # controller'a birden açardı. Dar olan seçildi.
    #
    # ^~ ÖNEKİ: bu blok eşleşince nginx regex location'lara BAKMAZ.
    # /api/hubs/ ile başlamayan hiçbir yol buraya düşmez.
    #
    # ÇEREZ: enderun_token httpOnly + sameSite=lax. WS el sıkışması
    # aynı alan adına yapılan bir GET'tir, yani same-site — lax kısıtı
    # yalnız cross-site istekleri etkiler, çerez gider. Arka uç bu
    # çerezi YALNIZ /api/hubs yolunda okuyor (Program.cs).
    location ^~ /api/hubs/ {
        proxy_pass http://127.0.0.1:5155;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Uzun ömürlü bağlantı: varsayılan 60 sn okuma zaman aşımı
        # WebSocket'i her dakika kopartırdı.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api {
        proxy_pass http://127.0.0.1:5155;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # HSTS: tarayıcı bu alan adını bir yıl boyunca yalnız HTTPS ile
    # açar, düz HTTP'ye hiç çıkmaz. Giriş çerezi `secure` olduğundan
    # düz HTTP'de saklanmıyor ve oturum sessizce açılmıyor; HSTS o
    # yolu tarayıcı tarafında da kapatıyor.
    #
    # includeSubDomains ve preload BİLİNÇLİ olarak yok: ikisi de geri
    # alınması çok zor. Alt alan adlarının tamamının HTTPS olduğu
    # doğrulanmadan includeSubDomains açılırsa HTTPS'siz bir alt alan
    # bir yıl boyunca erişilemez hale gelir.
    add_header Strict-Transport-Security "max-age=31536000" always;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/enderunai.com.tr/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/enderunai.com.tr/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.enderunai.com.tr) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = enderunai.com.tr) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name enderunai.com.tr www.enderunai.com.tr;
    return 404; # managed by Certbot




}
