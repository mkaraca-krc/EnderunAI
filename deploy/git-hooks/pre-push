#!/usr/bin/env bash
#
# PRE-PUSH — UCUZ KAPILAR YERELDE DE KOŞAR.
#
# ═══ NEDEN VAR ═══
#
# PAROLA/1'de kurumsal kimlik taraması yayında düştü ve ben o kontrolü
# YERELDE KOŞMAYI UNUTMUŞTUM. 24 saniyelik bir kontrol, 27 dakikalık
# iki tam turdan sonra kırmızı verdi.
#
# İki ayrı kusur vardı: kapının YERİ (safe-deploy içinde geç) ve
# ALIŞKANLIK (yerelde koşmayı unutmak). Sıra betikte düzeltildi;
# alışkanlık ise hatırlamaya bırakılamaz — bu kanca onu mekanik
# kılıyor.
#
# ═══ AYNI BETİK ═══
#
# Kapı listesi burada TEKRAR EDİLMİYOR: `ucuz-kapilar.sh` çağrılıyor,
# safe-deploy'un çağırdığı betiğin ta kendisi. İki yerde iki liste,
# ayrışan bir nokta demekti.
#
# ═══ ATLAMA ═══
#
# Acil bir durumda `git push --no-verify` ile atlanabilir. Bu bilerek
# açık: kapı, insanı doğru işi yapmaktan caydırmamalı (Kural 42).
# Ama atlamak GÖRÜNÜR bir seçim olur, unutmak gibi sessiz değil.

set -uo pipefail

KOK="$(git rev-parse --show-toplevel)"
BETIK="${KOK}/deploy/scripts/ucuz-kapilar.sh"

if [ ! -x "$BETIK" ]; then
    echo "[pre-push] UYARI: ucuz-kapilar.sh bulunamadı ($BETIK)." >&2
    echo "[pre-push] Kapılar KOŞULMADI. Push'a izin veriliyor ama" >&2
    echo "[pre-push] bu bir eksiklik — betiği geri getirin." >&2
    exit 0
fi

# ═══ YALNIZ `hizli` KAPILAR — ÖLÇÜMLE BULUNDU ═══
#
# İlk hâl dört kapıyı da koşuyordu ve PUSH DÜŞTÜ:
# "Connection to github.com closed by remote host."
#
# Git, SSH bağlantısını kancadan ÖNCE açıyor; kanca 362 saniye sürünce
# uzak uç boşta kalan bağlantıyı kapattı. Süreyi tek bir kapı
# götürüyordu: sır bekçisi (278 sn — arka ucu yeniden derliyor).
#
# DÜRÜST SINIR: sır bekçisi push öncesinde ÇALIŞMIYOR, yalnız yayın
# turunda çalışıyor. Kancanın verdiği güvence, listenin `hizli` kısmı.
#
# LİSTE YİNE TEK: ayrım listenin kendi alanında (`hizli`/`agir`),
# burada ikinci bir liste yok.
# ═══ PUSH ARALIĞI GIT'İN STDIN'İNDEN OKUNUYOR ═══
#
# git, pre-push kancasına her ref için bir satır verir:
#   <yerel ref> <yerel sha> <uzak ref> <uzak sha>
#
# Sır tarayıcı bu aralığı COMMIT COMMIT geziyor. Uç nokta farkı
# YETMEZ: aradaki bir commit'te doğup sonraki commit'te silinen bir
# sır, uç noktalarda görünmez ama GEÇMİŞE YAZILIR.
#
# İLK PUSH: uzak sha 0000... olur; tarayıcı o durumda push edilen tüm
# commit'leri gezer.
while read -r _yerel_ref yerel_sha _uzak_ref uzak_sha; do
    [ -z "${yerel_sha:-}" ] && continue
    # Silinen dal (yerel sha sıfır): taranacak commit yok.
    case "$yerel_sha" in *[!0]*) ;; *) continue ;; esac
    export SIR_ARALIK_UZAK="$uzak_sha"
    export SIR_ARALIK_YEREL="$yerel_sha"
    break
done

echo "[pre-push] Ucuz kapılar koşuluyor (hızlı küme; atlamak için --no-verify)..."

if ! REPO_ROOT="$KOK" "$BETIK" --hizli; then
    echo "[pre-push] Push DURDURULDU: ucuz kapılardan biri düştü." >&2
    exit 1
fi

exit 0
